# Normalise text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not be modified by Git.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary